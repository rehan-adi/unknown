{
	"name": "unknown",
	"version": "1.0.0",
	"description": "You ask what you don't know to unknown",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"start:api-service": "cd services/api-service && bun run src/server.ts",
		"format:inference-service": "cd services/inference-service && uvx ruff format . && uvx ruff check --fix .",
		"start:inference-service": "cd services/inference-service && uv run uvicorn src.server:app --host 0.0.0.0 --port 8000"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"services/*"
	],
	"author": {
		"name": "Rehan",
		"email": "official.rehan.me@gmail.com"
	},
	"license": "MIT",
	"keywords": [
		"unknown",
		"ai",
		"rag",
		"bun",
		"hono",
		"python",
		"postgresql",
		"typescript"
	],
	"devDependencies": {
		"@types/bun": "latest",
		"prettier": "^3.6.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rehan-adi/unknown"
	},
	"packageManager": "bun@1.2.17",
	"engines": {
		"bun": ">=1.2.17"
	}
}
